# ============================================================
# QllmSoft — Apache/Hostinger equivalent of the IIS web.config
# ============================================================

RewriteEngine On
RewriteRule ^canary-test-123/?$ https://qllmsoft.com/blog [R=301,L]

# ---- 1. Force HTTPS ----
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2. Remove www ----
RewriteCond %{HTTP_HOST} ^www\.qllmsoft\.com$ [NC]
RewriteRule ^(.*)$ https://qllmsoft.com/$1 [L,R=301]

# ============================================================
# CANNIBALIZATION FIXES (2026-09) — 8 slugs that existed as both
# a dedicated page and a /blog/ article. Each 301s the loser to
# the winner. Must come BEFORE the React Router catch-all below.
# ============================================================
RewriteRule ^best-software-house-in-pakistan/?$ https://qllmsoft.com/blog/best-software-house-in-pakistan [R=301,L]
RewriteRule ^website-development-cost-in-pakistan/?$ https://qllmsoft.com/blog/website-development-cost-in-pakistan [R=301,L]
RewriteRule ^outsource-software-development-to-pakistan/?$ https://qllmsoft.com/blog/outsource-software-development-to-pakistan [R=301,L]
RewriteRule ^blog/ai-powered-software-solutions/?$ https://qllmsoft.com/ai-powered-software-solutions [R=301,L]
RewriteRule ^blog/education-software-development-pakistan/?$ https://qllmsoft.com/education-software-development-pakistan [R=301,L]
RewriteRule ^mobile-app-development-cost-in-pakistan/?$ https://qllmsoft.com/blog/mobile-app-development-cost-in-pakistan [R=301,L]
RewriteRule ^outsource-mobile-app-development-to-pakistan/?$ https://qllmsoft.com/blog/outsource-mobile-app-development-to-pakistan [R=301,L]
RewriteRule ^blog/hire-angular-developers-pakistan/?$ https://qllmsoft.com/hire-angular-developers-pakistan [R=301,L]

# ---- 3. React Router SPA fallback ----
# Serve index.html for any route that isn't a real file/folder,
# so /blog/whatever-slug loads the React app instead of a 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ---- 4. Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- 5. Cache static assets, never cache index.html ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# ---- 6. Security headers ----
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
