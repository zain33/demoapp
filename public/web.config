<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════
         1. URL REWRITING — React Router + SEO Redirects
    ═══════════════════════════════════════════════════ -->
    <rewrite>
      <rules>

        <!-- Rule 1: Force HTTPS (HTTP → HTTPS) -->
        <rule name="robots" stopProcessing="true">
          <match url="^robots\.txt$" />
          <action type="Rewrite" url="/robots.txt" />
        </rule>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Remove WWW (www.qllmsoft.com → qllmsoft.com) -->
        <!-- IMPORTANT: If you PREFER www, swap the match/action below -->
        <rule name="Remove WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.qllmsoft\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://qllmsoft.com/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 3: Remove trailing slash (except root /) -->
        <!-- /hire-react-developers-pakistan/ → /hire-react-developers-pakistan -->
        <rule name="Remove Trailing Slash" stopProcessing="true">
          <match url="(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 4: Remove .html extension -->
        <!-- /about.html → /about -->
        <rule name="Remove HTML Extension" stopProcessing="true">
          <match url="^(.*?)\.html$" />
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             SEO REDIRECTS — Retire dead/old-migration URLs (2026-08-20)
             These pages are NOT in the live sitemap and are confirmed or
             presumed deleted; Google still has old cached/rendered
             versions of them indexed, so they need a 301 to a real live
             page or Google will keep serving dead links in search results
             indefinitely. Must sit here: after the clean-URL rules above
             and before the React Router SPA catch-all below.
        ═══════════════════════════════════════════════════ -->

        <!-- CONFIRMED deleted — old page, replaced by best-software-house-in-pakistan -->
        <rule name="Redirect - top-software-house-in-pakistan (deleted)" stopProcessing="true">
          <match url="^top-software-house-in-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/best-software-house-in-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- ASSUMED deleted (not in live sitemap) — same "best software
             house" cluster, closest live page is the Pakistan-wide page.
             Confirm and change target if you have a live Lalamusa page
             under a different URL. -->
        <rule name="Redirect - best-software-house-in-lalamusa (assumed deleted)" stopProcessing="true">
          <match url="^best-software-house-in-lalamusa/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/best-software-house-in-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- ASSUMED deleted (not in live sitemap) — closest live page
             covering the same outsourcing intent. VERIFY this is the
             right target before deploying. -->
        <rule name="Redirect - outsource-web-development-to-pakistan (assumed deleted)" stopProcessing="true">
          <match url="^outsource-web-development-to-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/outsource-software-development-to-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- ASSUMED deleted (not in live sitemap) — no obvious live
             equivalent, sent to the services index. VERIFY this is
             the right target before deploying. -->
        <rule name="Redirect - document-control-software (assumed deleted)" stopProcessing="true">
          <match url="^document-control-software/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/services"
                  redirectType="Permanent" />
        </rule>

        <!-- ASSUMED deleted (not in live sitemap) — old blog path
             pattern (/blog-post/*), orphaned from the current /blog/*
             structure. -->
        <rule name="Redirect - old blog-post 1 (assumed deleted)" stopProcessing="true">
          <match url="^blog-post/how-we-build-secure-web-apps/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog"
                  redirectType="Permanent" />
        </rule>
        <rule name="Redirect - old blog-post 2 (assumed deleted)" stopProcessing="true">
          <match url="^blog-post/top-5-tools-for-agile-teams/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog"
                  redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             CANNIBALIZATION FIXES (added 2026-09-13) — 8 slugs that
             exist as BOTH a dedicated landing page AND a /blog/ article,
             found by scanning App.js + blogPostsData.js directly.
             Each rule below picks ONE winner and 301s the loser to it.
             The winners marked "RECOMMENDED — verify" are a best guess
             based on content type (guide/listicle content usually wins
             as the blog post; commercial "hire X" / core service pages
             usually win as the landing page). Open the losing page once
             and confirm it isn't actually the better/more complete page
             before you deploy — if it is, just swap the two URLs in
             that rule, nothing else changes.
        ═══════════════════════════════════════════════════ -->

        <!-- 1) CONFIRMED pattern, RECOMMENDED winner: blog (rich FAQ/ItemList listicle) -->
        <rule name="Cannibalization fix - best-software-house-in-pakistan" stopProcessing="true">
          <match url="^best-software-house-in-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog/best-software-house-in-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 2) RECOMMENDED winner: blog (pricing/guide content, has PriceSpecification schema) -->
        <rule name="Cannibalization fix - website-development-cost-in-pakistan" stopProcessing="true">
          <match url="^website-development-cost-in-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog/website-development-cost-in-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 3) RECOMMENDED winner: blog (comprehensive guide with FAQ) -->
        <rule name="Cannibalization fix - outsource-software-development-to-pakistan" stopProcessing="true">
          <match url="^outsource-software-development-to-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog/outsource-software-development-to-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 4) RECOMMENDED winner: landing page (core service offering, commercial keyword) -->
        <rule name="Cannibalization fix - ai-powered-software-solutions" stopProcessing="true">
          <match url="^blog/ai-powered-software-solutions/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/ai-powered-software-solutions"
                  redirectType="Permanent" />
        </rule>

        <!-- 5) RECOMMENDED winner: landing page (industry vertical service page) -->
        <rule name="Cannibalization fix - education-software-development-pakistan" stopProcessing="true">
          <match url="^blog/education-software-development-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/education-software-development-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 6) RECOMMENDED winner: blog (cost guide, has PriceSpecification schema).
             NOTE: this URL also appears TWICE in sitemap.xml under different
             priorities (0.8 and 0.7) — remove both and add the /blog/ version once. -->
        <rule name="Cannibalization fix - mobile-app-development-cost-in-pakistan" stopProcessing="true">
          <match url="^mobile-app-development-cost-in-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog/mobile-app-development-cost-in-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 7) RECOMMENDED winner: blog (guide with FAQ + cost comparison table) -->
        <rule name="Cannibalization fix - outsource-mobile-app-development-to-pakistan" stopProcessing="true">
          <match url="^outsource-mobile-app-development-to-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/blog/outsource-mobile-app-development-to-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- 8) RECOMMENDED winner: landing page ("hire X developers" = recruitment/service commercial intent) -->
        <rule name="Cannibalization fix - hire-angular-developers-pakistan" stopProcessing="true">
          <match url="^blog/hire-angular-developers-pakistan/?$" />
          <action type="Redirect"
                  url="https://qllmsoft.com/hire-angular-developers-pakistan"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 5: React Router — serve index.html for all non-file, non-directory routes -->
        <!-- This MUST be last rule -->
        <rule name="React Router SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
  <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
  <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
  <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
  <add input="{REQUEST_URI}" pattern="^/sitemap\.xml$" negate="true" />
  <add input="{REQUEST_URI}" pattern="^/robots\.txt$" negate="true" />
</conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <!-- Outbound rules: add canonical header -->
      <outboundRules>
        <rule name="Add Vary Header">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
      </outboundRules>

    </rewrite>

    <!-- ═══════════════════════════════════════════════════
         2. COMPRESSION — Gzip for faster page loads (SEO)
    ═══════════════════════════════════════════════════ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/xml"          enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/atom+xml"     enabled="true" />
        <add mimeType="application/xaml+xml"     enabled="true" />
        <add mimeType="image/svg+xml"            enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- ═══════════════════════════════════════════════════
         3. CACHING — Browser cache for static assets (SEO/CWV)
    ═══════════════════════════════════════════════════ -->
    <staticContent>

      <!-- MIME types for modern file formats -->
      <remove fileExtension=".json"  />
      <remove fileExtension=".webp"  />
      <remove fileExtension=".woff"  />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".svg"   />
      <remove fileExtension=".ico"   />

      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />

      <!-- Cache hashed JS/CSS bundles for 1 year (React adds hash to filename) -->
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="365.00:00:00" />

    </staticContent>

    <!-- Cache headers per file type via location blocks -->
    <httpProtocol>
      <customHeaders>

        <!-- ═══════════════════════════════════════════════════
             4. SECURITY HEADERS — Trust signals + protection
        ═══════════════════════════════════════════════════ -->

        <!-- Prevent clickjacking -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Prevent MIME type sniffing -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- XSS Protection (legacy browsers) -->
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!-- Referrer Policy — send referrer on same-origin, shortened on cross-origin -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Permissions Policy — disable unused browser APIs -->
        <add name="Permissions-Policy"
             value="camera=(), microphone=(), geolocation=(), payment=()" />

        <!-- HSTS — force HTTPS for 1 year (only enable after HTTPS confirmed working) -->
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains" />

      </customHeaders>
    </httpProtocol>

    <!-- ═══════════════════════════════════════════════════
         5. DEFAULT DOCUMENT
    ═══════════════════════════════════════════════════ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ═══════════════════════════════════════════════════
         6. CUSTOM ERROR PAGES — Serve index.html for 404
         (React Router handles the UI for unknown routes)
    ═══════════════════════════════════════════════════ -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404"
             path="/index.html"
             responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ═══════════════════════════════════════════════════
         7. DIRECTORY BROWSING — Disable (security)
    ═══════════════════════════════════════════════════ -->
    <directoryBrowse enabled="false" />

  </system.webServer>

  <!-- ═══════════════════════════════════════════════════
       8. LOCATION-BASED CACHE CONTROL
       Long cache for hashed assets, no-cache for index.html
  ═══════════════════════════════════════════════════ -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <!-- Never cache index.html — always serve fresh -->
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma"        value="no-cache" />
          <add name="Expires"       value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="static">
    <system.webServer>
      <staticContent>
        <!-- Cache static/js and static/css for 1 year (they have content hash in filename) -->
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
