<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <!-- =========================================================
         1. URL REWRITE / CANONICAL URLS
         ========================================================= -->

    <rewrite>
      <rules>

        <!-- =====================================================
             CANONICAL DOMAIN
             http://qllmsoft.com
             http://www.qllmsoft.com
             https://www.qllmsoft.com

             All become:
             https://qllmsoft.com/...
             ===================================================== -->

        <rule name="Canonical HTTPS and Non-WWW" stopProcessing="true">
          <match url="(.*)" />

          <conditions logicalGrouping="MatchAny">

            <!-- HTTP -> HTTPS -->
            <add
              input="{HTTPS}"
              pattern="^OFF$"
              ignoreCase="true" />

            <!-- WWW -> non-WWW -->
            <add
              input="{HTTP_HOST}"
              pattern="^www\.qllmsoft\.com$"
              ignoreCase="true" />

          </conditions>

          <action
            type="Redirect"
            url="https://qllmsoft.com/{R:1}"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             2. REMOVE TRAILING SLASH
             /about/ -> /about
             
             Real directories are excluded.
             Root "/" is unaffected.
             ===================================================== -->

        <rule name="Remove Trailing Slash" stopProcessing="true">
          <match url="(.+)/$" />

          <conditions>
            <add
              input="{REQUEST_FILENAME}"
              matchType="IsDirectory"
              negate="true" />
          </conditions>

          <action
            type="Redirect"
            url="/{R:1}"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             3. REMOVE .HTML
             /about.html -> /about
             ===================================================== -->

        <rule name="Remove HTML Extension" stopProcessing="true">
          <match url="^(.*?)\.html$" />

          <action
            type="Redirect"
            url="/{R:1}"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             4. OLD / DELETED URL REDIRECTS
             ===================================================== -->


        <!-- Old top software house URL -->
        <rule
          name="Redirect top-software-house-in-pakistan"
          stopProcessing="true">

          <match url="^top-software-house-in-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/best-software-house-in-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- Old Lalamusa software house URL -->
        <rule
          name="Redirect best-software-house-in-lalamusa"
          stopProcessing="true">

          <match url="^best-software-house-in-lalamusa/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/best-software-house-in-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- REMOVED 2026-09-21: "Redirect outsource-web-development-to-pakistan"
             used to live here and 301'd this URL to
             /outsource-software-development-to-pakistan. That contradicted the
             sitemap (which lists /outsource-web-development-to-pakistan itself
             as the live canonical page, lastmod 2026-08-22) and App.js (which
             serves a real OutsourceWebDevelopmentPakistan component at this
             exact path). The rule was deleted so this URL serves its own page
             again instead of fighting the sitemap. -->


        <!-- Old document-control URL -->
        <rule
          name="Redirect document-control-software"
          stopProcessing="true">

          <match url="^document-control-software/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/services"
            redirectType="Permanent" />
        </rule>


        <!-- Old blog-post URL -->
        <rule
          name="Redirect old secure-web-apps-post"
          stopProcessing="true">

          <match url="^blog-post/how-we-build-secure-web-apps/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog"
            redirectType="Permanent" />
        </rule>


        <!-- Old blog-post URL -->
        <rule
          name="Redirect old agile-tools-post"
          stopProcessing="true">

          <match url="^blog-post/top-5-tools-for-agile-teams/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog"
            redirectType="Permanent" />
        </rule>


        <!-- ADDED 2026-09-21: remaining deleted /blog-post/* and old-site URLs -->

        <rule name="Redirect blog-post mobile-app-devsecops" stopProcessing="true">
          <match url="^blog-post/mobile-app-devsecops/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/mobile-app-devsecops-in-2026" redirectType="Permanent" />
        </rule>

        <rule name="Redirect asp-net-core-development" stopProcessing="true">
          <match url="^asp-net-core-development/?$" />
          <action type="Redirect" url="https://qllmsoft.com/asp-net-core-development-services" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post role-based-access-ecommerce-operations" stopProcessing="true">
          <match url="^blog-post/role-based-access-ecommerce-operations/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/role-based-access-problems-why-teams-break-systems" redirectType="Permanent" />
        </rule>

        <rule name="Redirect csharp-desktop-application-development" stopProcessing="true">
          <match url="^csharp-desktop-application-development/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/csharp-desktop-application-development" redirectType="Permanent" />
        </rule>

        <rule name="Redirect scalable-ecommerce-development-for-smbs" stopProcessing="true">
          <match url="^scalable-ecommerce-development-for-smbs/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/scalable-ecommerce-development-for-smbs" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post website-development-cost-in-pakistan" stopProcessing="true">
          <match url="^blog-post/website-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/website-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post custom-vs-saas-ecommerce" stopProcessing="true">
          <match url="^blog-post/custom-vs-saas-ecommerce-platforms-for-growing-businesses/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/custom-vs-saas-ecommerce-for-growing-smbs" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post legacy-vs-rebuilding" stopProcessing="true">
          <match url="^blog-post/legacy-system-modernization-vs-rebuilding/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/legacy-system-modernization-without-downtime-or-data-loss" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post legacy-cost-2026" stopProcessing="true">
          <match url="^blog-post/legacy-system-modernization-cost-in-2026/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/legacy-system-modernization-without-downtime-or-data-loss" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post security-challenges-ecommerce" stopProcessing="true">
          <match url="^blog-post/security-challenges-scalable-ecommerce-smbs/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/scalable-ecommerce-development-for-smbs" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post shopify-limitations" stopProcessing="true">
          <match url="^blog-post/how-smbs-can-build-scalable-ecommerce-platforms-without-shopify-limitations/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog/shopify-isnt-scaling-what-companies-do-next" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post custom-software-growth-2026" stopProcessing="true">
          <match url="^blog-post/custom-software-business-growth-2026/?$" />
          <action type="Redirect" url="https://qllmsoft.com/custom-software-development-services" redirectType="Permanent" />
        </rule>

        <rule name="Redirect blog-post custom-software-future" stopProcessing="true">
          <match url="^blog-post/why-custom-software-is-the-future/?$" />
          <action type="Redirect" url="https://qllmsoft.com/custom-software-development-services" redirectType="Permanent" />
        </rule>

        <rule name="Redirect old resources hub" stopProcessing="true">
          <match url="^resources/?$" />
          <action type="Redirect" url="https://qllmsoft.com/blog" redirectType="Permanent" />
        </rule>

        <!-- 410: genuinely gone, no replacement content on the new site -->

        <rule name="Gone blog-post pakistani-businesses-go-global" stopProcessing="true">
          <match url="^blog-post/pakistani-businesses-go-global-tech-strategy/?$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This page has been permanently removed" />
        </rule>

        <rule name="Gone blog-post mobile-app-performance-optimization" stopProcessing="true">
          <match url="^blog-post/mobile-app-performance-optimization/?$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This page has been permanently removed" />
        </rule>

        <rule name="Gone orphan pdfs" stopProcessing="true">
          <match url="^pdfs/.*\.pdf$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This page has been permanently removed" />
        </rule>

        <!-- Catch-all: any other surviving /blog-post/* URL not matched above -->
        <rule name="Gone blog-post catch-all" stopProcessing="true">
          <match url="^blog-post/.*$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This page has been permanently removed" />
        </rule>


        <!-- =====================================================
             5. CANNIBALIZATION / DUPLICATE CONTENT
             
             IMPORTANT:
             Only one URL remains indexable for each duplicate
             topic.
             ===================================================== -->


        <!-- =====================================================
             #1
             /best-software-house-in-pakistan
             ->
             /blog/best-software-house-in-pakistan
             ===================================================== -->

        <rule
          name="SEO best-software-house consolidation"
          stopProcessing="true">

          <match url="^best-software-house-in-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/best-software-house-in-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #2
             /website-development-cost-in-pakistan
             ->
             /blog/website-development-cost-in-pakistan
             ===================================================== -->

        <rule
          name="SEO website-development-cost consolidation"
          stopProcessing="true">

          <match url="^website-development-cost-in-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/website-development-cost-in-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #3
             KEEP the commercial outsourcing landing page.

             The landing page is the primary commercial URL:
             /outsource-software-development-to-pakistan

             Therefore the BLOG version, if it is merely a
             duplicate, should point TO the service page.

             This is intentionally the reverse of the previous
             configuration.
             ===================================================== -->

        <rule
          name="SEO outsource-software-development blog consolidation"
          stopProcessing="true">

          <match url="^blog/outsource-software-development-to-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/outsource-software-development-to-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #4
             Blog AI page -> commercial AI service page
             ===================================================== -->

        <rule
          name="SEO AI software consolidation"
          stopProcessing="true">

          <match url="^blog/ai-powered-software-solutions/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/ai-powered-software-solutions"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #5
             Blog education page -> education service page
             ===================================================== -->

        <rule
          name="SEO education software consolidation"
          stopProcessing="true">

          <match url="^blog/education-software-development-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/education-software-development-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #6
             Mobile app development cost:
             old/root URL -> detailed blog guide
             ===================================================== -->

        <rule
          name="SEO mobile-app-development-cost consolidation"
          stopProcessing="true">

          <match url="^mobile-app-development-cost-in-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/mobile-app-development-cost-in-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #7
             Outsource mobile app:
             old/root service page -> newer detailed guide
             ===================================================== -->

        <rule
          name="SEO outsource-mobile-app consolidation"
          stopProcessing="true">

          <match url="^outsource-mobile-app-development-to-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/blog/outsource-mobile-app-development-to-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             #8
             Hire Angular Developers:
             BLOG version -> commercial service page
             ===================================================== -->

        <rule
          name="SEO hire-angular-developers consolidation"
          stopProcessing="true">

          <match url="^blog/hire-angular-developers-pakistan/?$" />

          <action
            type="Redirect"
            url="https://qllmsoft.com/hire-angular-developers-pakistan"
            redirectType="Permanent" />
        </rule>


        <!-- =====================================================
             6. REACT ROUTER SPA FALLBACK
             
             MUST BE THE LAST REWRITE RULE.
             ===================================================== -->

        <rule name="React Router SPA" stopProcessing="true">

          <match url=".*" />

          <conditions logicalGrouping="MatchAll">

            <!-- Don't rewrite real files -->
            <add
              input="{REQUEST_FILENAME}"
              matchType="IsFile"
              negate="true" />

            <!-- Don't rewrite real directories -->
            <add
              input="{REQUEST_FILENAME}"
              matchType="IsDirectory"
              negate="true" />

            <!-- Don't rewrite API -->
            <add
              input="{REQUEST_URI}"
              pattern="^/api/"
              negate="true" />

            <!-- Don't rewrite sitemap -->
            <add
              input="{REQUEST_URI}"
              pattern="^/sitemap\.xml$"
              negate="true" />

            <!-- Don't rewrite robots -->
            <add
              input="{REQUEST_URI}"
              pattern="^/robots\.txt$"
              negate="true" />

          </conditions>

          <action
            type="Rewrite"
            url="/index.html" />

        </rule>

      </rules>
    </rewrite>


    <!-- =========================================================
         COMPRESSION
         
         Do NOT define the gzip DLL/scheme here.
         ========================================================= -->

    <urlCompression
      doStaticCompression="true"
      doDynamicCompression="true" />


    <!-- =========================================================
         STATIC CONTENT
         ========================================================= -->

    <staticContent>

      <!-- Prevent duplicate MIME mappings -->

      <remove fileExtension=".json" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".svg" />
      <remove fileExtension=".ico" />


      <!-- MIME TYPES -->

      <mimeMap
        fileExtension=".json"
        mimeType="application/json" />

      <mimeMap
        fileExtension=".webp"
        mimeType="image/webp" />

      <mimeMap
        fileExtension=".woff"
        mimeType="font/woff" />

      <mimeMap
        fileExtension=".woff2"
        mimeType="font/woff2" />

      <mimeMap
        fileExtension=".svg"
        mimeType="image/svg+xml" />

      <mimeMap
        fileExtension=".ico"
        mimeType="image/x-icon" />


      <!-- Default static cache -->

      <clientCache
        cacheControlMode="UseMaxAge"
        cacheControlMaxAge="365.00:00:00" />

    </staticContent>


    <!-- =========================================================
         SECURITY HEADERS
         ========================================================= -->

    <httpProtocol>
      <customHeaders>

        <remove name="X-Frame-Options" />
        <add
          name="X-Frame-Options"
          value="SAMEORIGIN" />


        <remove name="X-Content-Type-Options" />
        <add
          name="X-Content-Type-Options"
          value="nosniff" />


        <remove name="X-XSS-Protection" />
        <add
          name="X-XSS-Protection"
          value="1; mode=block" />


        <remove name="Referrer-Policy" />
        <add
          name="Referrer-Policy"
          value="strict-origin-when-cross-origin" />


        <remove name="Permissions-Policy" />
        <add
          name="Permissions-Policy"
          value="camera=(), microphone=(), geolocation=(), payment=()" />


        <!--
          HSTS:
          Keep only if ALL QllmSoft subdomains support HTTPS.
        -->

        <remove name="Strict-Transport-Security" />
        <add
          name="Strict-Transport-Security"
          value="max-age=31536000; includeSubDomains" />

      </customHeaders>
    </httpProtocol>


    <!-- =========================================================
         DEFAULT DOCUMENT
         ========================================================= -->

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>


    <!-- =========================================================
         DIRECTORY BROWSING
         ========================================================= -->

    <directoryBrowse enabled="false" />

  </system.webServer>


  <!-- ===========================================================
       INDEX.HTML
       
       Never cache index.html.
       React's entry file should always be fresh.
       =========================================================== -->

  <location path="index.html">

    <system.webServer>

      <staticContent>

        <clientCache
          cacheControlMode="DisableCache" />

      </staticContent>


      <httpProtocol>

        <customHeaders>

          <remove name="Cache-Control" />
          <add
            name="Cache-Control"
            value="no-cache, no-store, must-revalidate" />

          <remove name="Pragma" />
          <add
            name="Pragma"
            value="no-cache" />

          <remove name="Expires" />
          <add
            name="Expires"
            value="0" />

        </customHeaders>

      </httpProtocol>

    </system.webServer>

  </location>


  <!-- ===========================================================
       STATIC ASSETS
       
       /static/*
       Cache for one year because React build assets are hashed.
       =========================================================== -->

  <location path="static">

    <system.webServer>

      <staticContent>

        <clientCache
          cacheControlMode="UseMaxAge"
          cacheControlMaxAge="365.00:00:00" />

      </staticContent>


      <httpProtocol>

        <customHeaders>

          <remove name="Cache-Control" />

          <add
            name="Cache-Control"
            value="public, max-age=31536000, immutable" />

        </customHeaders>

      </httpProtocol>

    </system.webServer>

  </location>

</configuration>